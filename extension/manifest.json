{
  "manifest_version": 3,
  "name": "KeeCove",
  "description": "Füllt Anmeldeformulare mit Zugangsdaten aus deinem entsperrten KeeCove-Tresor.",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "KeeCove",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
