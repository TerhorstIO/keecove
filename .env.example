# Host and container HTTPS port
# KEEVAULT_PORT=8080
# Use the image published by GitHub Actions
# KEEVAULT_IMAGE=ghcr.io/terhorstio/keevault:latest
# Optional path for the local certificate and key (outside synced directories)
# KEEVAULT_TLS_DIR=C:/Users/YourName/AppData/Local/.keevault/tls

# Linux: UID and GID of the owner of the TLS directory
# KEEVAULT_UID=1000
# KEEVAULT_GID=1000

# Optional HTTPS reverse proxy and separate HTTP access credentials
# PUBLIC_ORIGIN=https://vault.example.org
# VAULT_HTTP_USER=keevault
# VAULT_HTTP_PASSWORD=

# Optional public OAuth app IDs for private cloud imports
# Register the exact redirect URL https://localhost:8080/cloud-callback.html
# CLOUD_ONEDRIVE_CLIENT_ID=
# CLOUD_ONEDRIVE_TENANT=common
# CLOUD_GOOGLE_CLIENT_ID=
# CLOUD_DROPBOX_CLIENT_ID=
